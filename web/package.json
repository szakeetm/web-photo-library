		"fake-indexeddb": "^6.2.8",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"typescript": "^6.0.3",
		"vite": "^8.3.8",
		"vitest": "^5.1.1",
		"webgpu": "^0.6.2"
	},
	"dependencies": {
		"blurhash": "^2.0.5",
		"idb": "^8.0.4",
		"maplibre-gl": "^6.19.0"
